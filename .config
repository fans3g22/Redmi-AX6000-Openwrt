# 目标设备：小米 / 红米 Redmi AX6000 (MT7986A Filogic 原厂 Stock 布局)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y

# 内核 eBPF / BTF 调试信息支持 (Honk eBPF CO-RE 必备)
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_BPF_EVENTS=y

# 核心内核模块与 eBPF / 网络栈支持 (Honk 必备)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y

# 全硬件流控 (Flow Offloading / HW NAT 驱动模块支持)
CONFIG_PACKAGE_kmod-nft-offload=y

# Honk 基于 eBPF 的高性能透明代理核心与 LuCI 界面
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_honk=y

# 最新 GeoData 规则 (供 Honk 等透明代理使用)
CONFIG_PACKAGE_v2ray-geodata=y

# UPnP 端口自动映射与中文语言包
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# SQM 智能队列管理 (防跳 ping / 抗 Bufferbloat)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# 无线网络 (完整版 wpad 原生支持 802.11k/v/r 快速漫游与 usteer 弱信号剔除)
CONFIG_PACKAGE_wpad-wolfssl=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# LuCI Web 控制台与中文语言支持
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_LUCI_LANG_zh_Hans=y

# 系统基础运维与防火墙
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
